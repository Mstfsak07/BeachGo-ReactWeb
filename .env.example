# ─── Veritabanı (PostgreSQL) ─────────────────────────────
# 1) En basit yol: tam connection string ver
BEACHGO_DB_CONN=

# 2) Alternatif: parcalı DB env'leri ile baglan
BEACHGO_DB_NAME=beachgo_db
BEACHGO_DB_USER=beach_admin
BEACHGO_DB_PASSWORD=change-me

# Cloud SQL TCP baglantisi icin:
BEACHGO_DB_HOST=127.0.0.1
BEACHGO_DB_PORT=5432

# Cloud Run + Cloud SQL connector ile Unix socket baglantisi icin:
# CLOUD_SQL_CONNECTION_NAME=project-id:region:instance-name
CLOUD_SQL_CONNECTION_NAME=

# ─── JWT Secret (min. 32 karakter — üretimde mutlaka değiştirin!) ──
BEACHGO_JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters!!

# ─── CORS ────────────────────────────────────────────────
BEACHGO_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Stripe ──────────────────────────────────────────────
# ASP.NET Core config binding icin cift alt cizgi kullanin.
# Stripe:SecretKey -> Stripe__SecretKey
# Stripe:WebhookSecret -> Stripe__WebhookSecret
# Stripe:PublishableKey -> Stripe__PublishableKey
Stripe__PublishableKey=pk_test_your_publishable_key_here
Stripe__SecretKey=sk_test_your_stripe_key_here
# Dashboard → Webhooks → imza için signing secret (whsec_...)
Stripe__WebhookSecret=whsec_your_signing_secret_here

# ─── ASP.NET Core ────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development

# ─── Frontend ────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:5143/api
VITE_API_URL=http://localhost:5143/api

# ─── E-posta / Resend ─────────────────────────────────────
# Bu key varsa development dahil gerçek mail gönderilir.
# resend.com'dan alınan API key'i buraya girin.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Google Cloud Storage ─────────────────────────────────
# Gcs:BucketName -> Gcs__BucketName
Gcs__BucketName=your-public-bucket-name
# Local development icin gerekirse service account json yolu:
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Frontend URL (doğrulama mailindeki link bu URL'yi kullanır)
APP_URL=http://localhost:3000

# Admin kullanıcı başlangıç şifresi (seed için zorunlu)
ADMIN_PASSWORD=
